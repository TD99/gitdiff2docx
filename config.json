{
    "$schema": "./schemas/config.schema.json",
    "language": "de",
    "verbose": true,
    "theme": "modern-dark",
    "diff_font": "Courier New",
    "diff_font_size": 8,
    "open_after_creation": true,
    "heading_level": 3,
    "file_encoding": "utf-8",
    "include_first_commit": true,
    "gdd_ignore_file_name": ".gddignore",
    "include_unchanged_lines": false,
    "include_images": true,
    "insert_page_breaks": true
}
